# ─────────────────────────────────────────────────────────────
# Aletheia AI — environment configuration
# Copy this file to `.env` and edit as needed.
# NEVER commit a real `.env` file. NEVER hardcode API keys.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────
# Provider abstraction is in src/aletheia/llm/base.py
# Default reference implementation: Ollama (open-source, local)
ALETHEIA_LLM_PROVIDER=ollama

# ── Ollama (default open-source provider) ────────────────────
# Install: https://ollama.ai
# Pull a model: `ollama pull llama3.1:8b-instruct-q5_K_M`
ALETHEIA_OLLAMA_BASE_URL=http://localhost:11434
ALETHEIA_OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M
ALETHEIA_OLLAMA_TIMEOUT=120
ALETHEIA_OLLAMA_TEMPERATURE=0.4
ALETHEIA_OLLAMA_NUM_CTX=8192

# ── OpenAI (optional alternative provider) ───────────────────
# ALETHEIA_LLM_PROVIDER=openai
# ALETHEIA_OPENAI_API_KEY=sk-...
# ALETHEIA_OPENAI_MODEL=gpt-4o-mini
# ALETHEIA_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic (optional alternative provider) ────────────────
# ALETHEIA_LLM_PROVIDER=anthropic
# ALETHEIA_ANTHROPIC_API_KEY=sk-ant-...
# ALETHEIA_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Database ─────────────────────────────────────────────────
# SQLite-first: zero-config local development
ALETHEIA_DB_PROVIDER=sqlite
ALETHEIA_DB_PATH=./data/aletheia.db

# PostgreSQL (production) — used when ALETHEIA_DB_PROVIDER=postgres
# ALETHEIA_DB_PROVIDER=postgres
# ALETHEIA_DB_URL=postgresql+psycopg://aletheia:aletheia@localhost:5432/aletheia

# ── Wisdom Graph ─────────────────────────────────────────────
ALETHEIA_WISDOM_GRAPH_SEED=true
ALETHEIA_WISDOM_GRAPH_SEED_PATH=src/aletheia/data/seed.jsonl

# ── Reflection Engine ────────────────────────────────────────
# Which reflection layers may be invoked (subset of: epistemic, psychological, practical, ethical, existential)
ALETHEIA_REFLECTION_LAYERS=epistemic,psychological,practical,ethical,existential
# Maximum epistemic decomposition depth (1-8)
ALETHEIA_DECOMPOSITION_DEPTH=8

# ── Safety Constitution ──────────────────────────────────────
# Hard switch. Disabling any of these is logged and rejected at runtime.
ALETHEIA_SAFETY_CONSTITUTION_ENFORCE=true
# Maximum consecutive turns before Aletheia explicitly invites a break (anti-dependency)
ALETHEIA_SAFETY_MAX_CONSECUTIVE_TURNS=12
# Refuse to produce responses claiming consciousness, divinity, or exclusive understanding
ALETHEIA_SAFETY_FORBIDDEN_CLAIMS=consciousness,divine_authority,exclusive_understanding,prophetic_insight

# ── API Server ───────────────────────────────────────────────
ALETHEIA_API_HOST=127.0.0.1
ALETHEIA_API_PORT=8000
ALETHEIA_API_LOG_LEVEL=info

# ── General ──────────────────────────────────────────────────
ALETHEIA_LOG_LEVEL=INFO
ALETHEIA_ENV=development
